# One block per operator. The prefix is the operator's key in core/constants/operators.js,
# upper-cased: key 'slotslv' reads SLOTSLV_URL. Adding an operator means adding a block here and
# one profile entry there.

# Copy to .env and fill in. The real values are affiliate account identifiers and are never committed.
# Run `npm run setup` after editing (npm start and npm test do it for you).

SLOTSLV_URL=https://record.revenuenetwork.com/<your-tracking-token>/1/
SLOTSLV_AFFID=<your-slots.lv-affiliate-id>
THUNDER_URL=https://go.thunder.partners/visit/?bta=<your-bta>&nci=<your-nci>&campaign=<your-campaign>&utm_campaign=<your-campaign>
THUNDER_CREATIVE_URL=https://thunder.ck-cdn.com/tn/serve/?cid=<your-creative-id>&utm_campaign=<your-campaign>&campaign=<your-campaign>&tracking_code=<your-campaign>
THUNDER_BTA=<your-bta>
THUNDER_PLACEMENT_ID=<your-placement-id>
